{
  "name": "@paid-tw/payment-zingala",
  "version": "0.1.0",
  "description": "中租零卡分期 (Zingala) BNPL adapter for @paid-tw/payment",
  "keywords": [
    "bnpl",
    "chailease",
    "payment",
    "taiwan",
    "zingala",
    "無卡分期",
    "零卡分期"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts src"
  },
  "dependencies": {
    "@paid-tw/payment": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "typescript": "^5.6.0"
  }
}
