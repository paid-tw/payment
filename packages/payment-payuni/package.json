{
  "name": "@paid-tw/payment-payuni",
  "version": "0.1.0",
  "description": "PAYUNi 統一金流 adapter for @paid-tw/payment — trade query (create/refund WIP).",
  "keywords": [
    "payment",
    "payuni",
    "taiwan",
    "統一金流",
    "金流"
  ],
  "homepage": "https://github.com/paid-tw/payment/tree/main/packages/payment-payuni#readme",
  "bugs": "https://github.com/paid-tw/payment/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paid-tw/payment.git",
    "directory": "packages/payment-payuni"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paid-tw/payment": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "typescript": "^5.6.0"
  }
}
