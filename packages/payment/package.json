{
  "name": "@paid-tw/payment",
  "version": "0.1.0",
  "description": "Provider-agnostic core for Taiwan payment gateways: unified types, PaymentProvider interface, capabilities, and PaymentError.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paid-tw/payment.git",
    "directory": "packages/payment"
  },
  "homepage": "https://github.com/paid-tw/payment/tree/main/packages/payment#readme",
  "bugs": "https://github.com/paid-tw/payment/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "payment",
    "gateway",
    "taiwan",
    "金流",
    "payuni",
    "newebpay",
    "ecpay"
  ],
  "publishConfig": {
    "access": "public"
  }
}
