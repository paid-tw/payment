# Copy to `.env` and fill in. `.env` / `.env.*` are gitignored; this file is not.
#
# Nothing here is needed for the normal offline suite (`pnpm test`) — those run
# against MSW. These are only for the env-gated live suites.
#
# ⚠️ This repo has no dotenv and vitest does not load `.env` into `process.env`
# (verified 2026-08-01: a var set only in `.env` reads back `undefined` inside a
# test). So a filled-in `.env` does nothing on its own — export it first:
#
#     set -a; source .env; set +a
#     pnpm test:live:zingala
#
# or prefix a single run: `ZINGALA_LIVE=1 ZINGALA_API_KEY=... pnpm vitest run …`

# --- shared ------------------------------------------------------------------

# Print raw gateway payloads. Used to re-record the field-exact fixtures that
# back the offline tests.
# PAID_DEBUG=1

# --- NewebPay 藍新金流 ---------------------------------------------------------
#
# Docs: 幕前支付 NDNF-1.2.3 + 信用卡定期定額 NDNP-1.0.7.
# Hosts: sandbox https://ccore.newebpay.com, prod https://core.newebpay.com.
# Credentials: 藍新金流會員專區 → 商店資料 → API 串接金鑰.

# Gate for the live suites (test:live:newebpay, test:live:newebpay:period).
# ⚠️ Each run fires ONE not-found query — the gateway locks QueryTradeInfo for
# 4 h (TRA10071) after too many not-found lookups within an hour; don't loop it.
# NEWEBPAY_LIVE=1

# NEWEBPAY_MERCHANT_ID=
# HashKey (32 chars) / HashIV (16 chars).
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=

# Optional: a real order to query instead of a bogus one (avoids spending the
# not-found budget). NEWEBPAY_QUERY_AMT must be that order's exact amount —
# QueryTradeInfo's CheckValue signs it.
# NEWEBPAY_QUERY_ID=
# NEWEBPAY_QUERY_AMT=

# --- 中租零卡分期 (Zingala) ---------------------------------------------------
#
# Docs: 中租零卡分期 API 串接技術手冊 1.1.14 (2023/11, not public).
# Hosts: UAT https://uatapi.chaileaseholding.com/api_zero_card
#        PROD https://api.chaileaseholding.com/api_zero_card

# Gate for the live suite, matching ECPAY_LIVE / PAYUNI_LIVE. Unset = skipped.
# ZINGALA_LIVE=1

# `0Card-Merchant-Id` header — 商家編號.
# ⚠️ Note the spelling: laravel-zingala calls this ZINGALA_MARCHANT_ID
# (misspelled). Do not copy that.
# ZINGALA_MERCHANT_ID=

# `0Card-API-Key` header — API 連線金鑰.
# ZINGALA_API_KEY=

# Decrypts `info_customer_json` on the notify (申請人姓名/身分證/手機).
# AES-256-CBC + PKCS#7. Manual: KEY 32 chars, IV 16 chars.
# ZINGALA_AES_KEY=
# ZINGALA_AES_IV=

# There is NO separate signing key. The `Digest` header is HMAC-SHA256 over the
# raw body keyed with ZINGALA_AES_KEY above — verified against 25 UAT responses
# on 2026-08-02, and the adapter has no config field for anything else. (The
# manual never states this; it only prints `Sample DATA_AESKEY (Secret Key)`
# under its notify example. An earlier draft of this file listed a
# ZINGALA_DIGEST_KEY as an open question — it was resolved, and no such variable
# is read.)

# --- Zingala: optional -------------------------------------------------------

# 總公司代號 `top_vender_id`. Only needed when the 撥款對象 differs from the
# default company behind ZINGALA_MERCHANT_ID. ("vender" is 中租's spelling of
# the wire field — kept so the env var greps to the API.)
# ZINGALA_TOP_VENDER_ID=

# 子商店代號 `store_id`, for merchants whose accounting splits by branch.
# ZINGALA_STORE_ID=

# An order id already sitting in transaction_state 003 / 004 / 005.
#
# Why this is unavoidable: the UAT environment cannot reach those states by API.
# Reaching 003 needs the test consumer APP (scan, password, ID upload) plus a
# human reviewer; 004/005 need 中租 staff to flip the state by hand, and capture
# in UAT just answers 199 because the batch job does not run there. So the
# inquiry / capture / refund live tests have to be pointed at an order someone
# already pushed through, the same way ECPAY_QUERY_ID works.
# ZINGALA_QUERY_ORDER_ID=

# Public URL of a local capture server (cloudflared tunnel), used to record a
# real notify_url POST. Same recipe as `pnpm capture:ecpay-notify`.
# ZINGALA_NOTIFY_URL=

# Override the API origin — e.g. UAT reached through an internal proxy. Routing
# only; it does not change which credentials are in play.
# ZINGALA_BASE_URL=
